# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://omni-scan-kappa.vercel.app

# ---- Supabase (SERVER ONLY - never put the service key in the frontend) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Auth ----
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- ML1 face service ----
ML1_URL=http://localhost:8001
MATCH_AUTO_THRESHOLD=0.80
MATCH_REVIEW_THRESHOLD=0.60

# ---- Lab + room code ----
# Coordinates of the lab (get them from Google Maps: right-click the lab -> copy lat,lng)
LAB_LAT=
LAB_LNG=
LAB_RADIUS_M=15
ROOM_TOKEN_TTL_SECONDS=30

# ---- Email for password-reset codes (optional in development: the code is printed in the terminal) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
