# Face identity verification
FACE_THRESHOLD=0.50

VERIFICATION_TARGET_FRAMES=8
VERIFICATION_MIN_GOOD_FRAMES=5
VERIFICATION_MIN_PASS_RATIO=0.75

# Enrollment
REGISTRATION_MIN_FRAMES=3
REGISTRATION_MAX_FRAMES=8
REGISTRATION_TARGET_FRAMES=5
ENROLLMENT_MIN_COHERENCE=0.45

# Attendance capture
ATTENDANCE_MIN_FRAMES=20
ATTENDANCE_MAX_FRAMES=60

# Image quality
MIN_FACE_AREA_RATIO=0.03
MIN_BLUR_VARIANCE=25.0
MAX_FRAME_BYTES=1048576

# Blink / liveness configuration validated in local end-to-end test
BLINK_MIN_OBSERVATIONS=10
BLINK_BASELINE_FRAMES=5
BLINK_MIN_CLOSED_FRAMES=2
BLINK_MIN_REOPEN_FRAMES=2
BLINK_CLOSE_FLOOR=0.20
BLINK_CLOSE_DELTA=0.08
BLINK_EYE_DELTA=0.03
BLINK_REOPEN_DELTA=0.04

# InsightFace
FACE_DET_SIZE=640
FACE_MODEL_NAME=buffalo_l
FACE_EMBEDDING_DIM=512

# Optional service-to-service authentication
# Leave empty for local development.
ML_API_KEY=

# Optional model directory
FACE_MODEL_DIR=
